# Ports: API = 5000, UI = 3000 (do not set backend PORT=3000 while Vite uses 3000).
#
# PostgreSQL is required. If sign-up fails with ECONNREFUSED, start the DB first:
#   docker compose up -d
#   cd backend && npm run db:migrate
#
# Install and run apps separately (no npm install at repository root):
#   cd backend && npm install && npm run dev   → http://localhost:5000
#   cd frontend && npm install && npm run dev  → http://localhost:3000
#
# Copy env files:
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
