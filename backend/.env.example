NODE_ENV=development
PORT=5000
# Use docker compose at repo root (postgres:postgres) or your own Postgres URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/udhar_diary
BETTER_AUTH_SECRET=replace-with-a-very-long-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5000
PAYMENT_REMINDER_CRON=0 9 * * *
PAYMENT_REMINDER_ENABLED=true
PAYMENT_REMINDER_TIMEZONE=UTC
FRONTEND_URL=http://localhost:3000
